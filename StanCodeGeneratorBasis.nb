Cell[BoxData[{
 RowBox[{
  RowBox[{"wDstMax", "=", 
   RowBox[{"w", "/.", 
    RowBox[{
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"qSQfuncDst", "[", "w", "]"}], "==", "0"}], ",", "w"}], "]"}],
      "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PreIntPerform", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"IntVariable", ",", "IntCoefficient"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Clear", "[", 
         RowBox[{"IntVariable", ",", "IntCoefficient"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"IntVariable", "=", 
         RowBox[{
          RowBox[{"Variables", "[", 
           RowBox[{"DecayRate", "[", 
            RowBox[{"\"\<Dst\>\"", ",", 
             RowBox[{"\"\<w_\>\"", "<>", "dist"}]}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"2", "\[Chi]"}], "]"}], "->", "Cos2Chi"}], ",", 
            RowBox[{
             RowBox[{"Cos", "[", "\[Chi]", "]"}], "->", "CosChi"}], ",", 
            RowBox[{"w", "->", "Nothing"}]}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"IntCoefficient", "=", 
         RowBox[{"MonomialList", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"DecayRate", "[", 
             RowBox[{"\"\<Dst\>\"", ",", 
              RowBox[{"\"\<w_\>\"", "<>", "dist"}]}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"2", "\[Chi]"}], "]"}], "->", "Cos2Chi"}], ",", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Chi]", "]"}], "->", "CosChi"}]}], 
             "}"}]}], ",", " ", "IntVariable"}], "]"}]}], ";", 
