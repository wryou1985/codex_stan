          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{"NPmodel", ",", "\"\<T\>\""}], "]"}], ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<C\>\"", "<>", "NPmodel", "<>", 
               "\"\< ~ normal(0, 0.5);\\n\>\""}], "}"}], "~", "Join", "~", 
             RowBox[{"ParaPriorNP", "[", 
              RowBox[{
              "NPmodel", ",", "FFprior", ",", "FFmodel", ",", "FFnf"}], 
              "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
             "\"\<C\>\"", "<>", "NPmodel", "<>", 
              "\"\< ~ normal(0, 0.5);\\n\>\""}], "}"}]}], "]"}]}], "]"}], "<>", 
        RowBox[{"ParaPrior", "[", 
         RowBox[{"FFprior", ",", "FFmodel", ",", "FFnf"}], "]"}], "<>", 
        "\"\<\nMILC15cent ~ multi_normal(MILC15func, MILC15cov);\n\
bglMILC21cent ~ multi_normal(MILC21func, bglMILC21cov);\nbglJLQCD23cent ~ \
