            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "10"}], "}"}]}], "]"}], "<>", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<rawBelleDst_cosV_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]= \>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<cosV\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "10"}], "}"}]}], "]"}], "<>", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<rawBelleDst_chi_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]= \>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<chi\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "10"}], "}"}]}], "]"}], "<>", 
        "\"\<\nBrRatio_data = multi_normal_rng(BrRatio2025cent , \
BrRatio2025cov);\nVcb_Br = sqrt(BrRatio_data ./ (rawBrRatio_func));\nVcb_mean \
= mean(sqrt(BrRatio2025cent ./ (rawBrRatio_func)));\nBrRatio_func = \
rawBrRatio_func * square(Vcb_mean);\nchi_sq[1] = dot_product(MILC15cent - \
MILC15func, inverse(MILC15cov) * (MILC15cent - MILC15func));\nchi_sq[2] = \
dot_product(bglMILC21cent - MILC21func, inverse(bglMILC21cov) * \
(bglMILC21cent - MILC21func));\nchi_sq[3] = dot_product(bglJLQCD23cent - \
JLQCD23func, inverse(bglJLQCD23cov) * (bglJLQCD23cent - JLQCD23func));\n\
chi_sq[4] = dot_product(\>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", 
          "\"\<bglHPQCD23cent - HPQCD23func\>\"", ",", 
          "\"\<bglHPQCD23centNoTensor - HPQCD23func\>\""}], "]"}], "<>", 
        "\"\< , \>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", 
          "\"\<inverse(bglHPQCD23cov) * (bglHPQCD23cent - HPQCD23func)\>\"", 
          ",", "\"\<inverse(bglHPQCD23covNoTensor) * (bglHPQCD23centNoTensor \
- HPQCD23func)\>\""}], "]"}], "<>", 
        "\"\<);\nchi_sq[5] = dot_product(BelleFITcent_D - BelleD_func, \
inverse(BelleFITcov_D) * (BelleFITcent_D - BelleD_func));\nchi_sq[6] = \
dot_product(BelleFITcent_w - BelleDst_w_func, inverse(BelleFITcov_w) * \
(BelleFITcent_w - BelleDst_w_func));\nchi_sq[7] = \
dot_product(BelleFITcent_cosL - BelleDst_cosL_func, inverse(BelleFITcov_cosL) \
* (BelleFITcent_cosL - BelleDst_cosL_func));\nchi_sq[8] = \
dot_product(BelleFITcent_cosV - BelleDst_cosV_func, inverse(BelleFITcov_cosV) \
* (BelleFITcent_cosV - BelleDst_cosV_func));\nchi_sq[9] = \
dot_product(BelleFITcent_chi - BelleDst_chi_func, inverse(BelleFITcov_chi) * \
(BelleFITcent_chi - BelleDst_chi_func));\nchi_sq[10] = \
dot_product(BrRatio2025cent - BrRatio_func, inverse(BrRatio2025cov) * \
(BrRatio2025cent - BrRatio_func));\nchi_sq[11] = dot_product(\>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", 
          "\"\<bszLCSR18cent - LCSR18func\>\"", ",", 
          "\"\<bszLCSR18centNoTensor - LCSR18func\>\""}], "]"}], "<>", 
        "\"\< , \>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", 
          "\"\<inverse(bszLCSR18cov) * (bszLCSR18cent - LCSR18func)\>\"", 
          ",", "\"\<inverse(bszLCSR18covNoTensor) * (bszLCSR18centNoTensor - \
LCSR18func)\>\""}], "]"}], "<>", 
        "\"\<);\nchi_sq[12] = dot_product(bszLCSR23cent - LCSR23func, \
inverse(bszLCSR23cov) * (bszLCSR23cent - LCSR23func));\nchi_sq[13] = \
dot_self((\>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", 
          "\"\<bszLCSR18cent - LCSR18func\>\"", ",", 
          "\"\<bszLCSR18centNoTensor - LCSR18func\>\""}], "]"}], "<>", 
        "\"\<) ./ sqrt(diagonal(\>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NPmodel", "==", "\"\<T\>\""}], ",", "\"\<bszLCSR18cov\>\"",
           ",", "\"\<bszLCSR18covNoTensor\>\""}], "]"}], "<>", 
        "\"\<)));\nchi_sq[14] = dot_self((bszLCSR23cent - LCSR23func) ./ \
sqrt(diagonal(bszLCSR23cov)));\nchi_sq_total = sum(chi_sq[1:12]);\n}\>\""}]}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ParamListAll", "=", 
       RowBox[{"ParamList", "/.", 
        RowBox[{"Vcb", "->", "Nothing"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "\"\<Stan_model/stancode_\>\"", "<>", "AnalysisName", "<>", 
