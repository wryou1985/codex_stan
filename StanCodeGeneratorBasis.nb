Cell[BoxData[
 RowBox[{
  RowBox[{"IntPerform", "[", 
   RowBox[{"f_", ",", "variable_", ",", "x_", ",", 
    RowBox[{"{", 
     RowBox[{"x1_", ",", "x2_"}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"f", "/", 
      RowBox[{"(", 
       RowBox[{"Times", "@@", 
        RowBox[{"(", 
         RowBox[{"variable", "^", 
          RowBox[{"Exponent", "[", 
           RowBox[{"f", ",", "variable"}], "]"}]}], ")"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "x1", ",", "x2"}], "}"}], ",", " ", "\n", "\t", 
     RowBox[{"PrecisionGoal", " ", "->", " ", "8"}], ",", " ", 
     RowBox[{"AccuracyGoal", " ", "->", " ", "8"}], ",", 
     RowBox[{"MaxRecursion", "->", "6"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<LocalAdaptive\>\"", ",", " ", 
        RowBox[{"\"\<SymbolicProcessing\>\"", " ", "->", " ", "0"}]}], 
       "}"}]}]}], "\n", "\t", "]"}], "*", 
   RowBox[{"(", 
    RowBox[{"Times", "@@", 
     RowBox[{"(", 
      RowBox[{"variable", "^", 
       RowBox[{"Exponent", "[", 
        RowBox[{"f", ",", "variable"}], "]"}]}], ")"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.954649736091902*^9, 3.954649770225008*^9}, {
