                  RowBox[{"zHQET", "[", "w", "]"}]}], "}"}]}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"NameBin", "=", 
               RowBox[{"Bin", "[", 
                RowBox[{"ObsName", ",", "Dist"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"IntVariable", "=", 
               RowBox[{
                RowBox[{"Variables", "[", 
                 RowBox[{"OrderObsFunc", "[", 
                  RowBox[{"ObsName", ",", "Dist", ",", "order"}], "]"}], 
                 "]"}], "/.", 
                RowBox[{
                 RowBox[{"ToExpression", "[", "Dist", "]"}], "\[Rule]", 
                 "Nothing"}]}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"IntCoefficient", "=", 
