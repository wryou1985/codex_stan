Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SpecifyModel", "[", 
    RowBox[{"FFmodel_", ",", "NF_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"FF", ",", "FFlist"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"FFlist", "=", 
       RowBox[{"{", 
        RowBox[{
        "fp", ",", "f0", ",", "fS", ",", "fT", ",", "A0", ",", "A1", ",", 
         "A12", ",", "V", ",", "P", ",", "T1", ",", "T2", ",", "T23"}], 
        "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "FFreplace", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"FFreplace", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"n", "->", 
          RowBox[{
           RowBox[{"ToExpression", "[", 
            RowBox[{"FFmodel", "<>", "\"\<ff\>\""}], "]"}], "[", 
           RowBox[{
            RowBox[{"FFmodel", "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "n", "]"}]}], ",", "NF", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"FFmodel", "==", "\"\<HQET\>\""}], ",", "w", ",", 
              "qSQ"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "FFlist"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Notice: (\>\"", "<>", "FFmodel", "<>", "\"\<, NF=\>\"", "<>", 
        RowBox[{"ToString", "[", "NF", "]"}], "<>", 
        "\"\<) is chosen. FF is stored in 'FFreplace'.\>\""}], "]"}], ";"}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
