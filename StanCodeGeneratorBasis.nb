 RowBox[{
  RowBox[{
   RowBox[{"HQETset", "[", "model_", "]"}], ":=", 
   RowBox[{"Which", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"model", "==", "\"\<3/2/1\>\""}], ",", 
