Cell[BoxData[
 RowBox[{
  RowBox[{"ObsIntPerform", "[", 
   RowBox[{"ObsName_", ",", "Dist_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "NameBin", ",", "IntVariable", ",", "IntBin", ",", "IntCoefficient"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"StringContainsQ", "[", 
       RowBox[{"ObsName", ",", "\"\<BrRatio\>\""}], "]"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IntVariable", "=", 
        RowBox[{
         RowBox[{"Variables", "[", 
          RowBox[{"ObsFunc", "[", 
           RowBox[{"ObsName", ",", "Dist"}], "]"}], "]"}], "/.", 
         RowBox[{"w", "\[Rule]", "Nothing"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"IntCoefficient", "=", 
        RowBox[{"MonomialList", "[", 
         RowBox[{
          RowBox[{"ObsFunc", "[", 
           RowBox[{"ObsName", ",", "Dist"}], "]"}], ",", " ", "IntVariable"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"IntBin", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ObsName", "==", "\"\<BrRatio2025\>\""}], ",", 
            RowBox[{
             RowBox[{"wMax", "[", "Dist", "]"}], "-", "0.0001"}], ",", 
            RowBox[{
             RowBox[{"wMaxTau", "[", "Dist", "]"}], "-", "0.0001"}]}], 
           "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Obs", "[", 
         RowBox[{"ObsName", ",", "Dist"}], "]"}], "=", 
        RowBox[{"Total", "[", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntPerform", "[", 
             RowBox[{"#", ",", "IntVariable", ",", "w", ",", "IntBin"}], 
             "]"}], "&"}], ",", "IntCoefficient"}], "]"}], "]"}]}], ";"}], 
      "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NameBin", "=", 
        RowBox[{"Bin", "[", 
         RowBox[{"ObsName", ",", "Dist"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"IntVariable", "=", 
        RowBox[{
         RowBox[{"Variables", "[", 
          RowBox[{"ObsFunc", "[", 
           RowBox[{"ObsName", ",", "Dist"}], "]"}], "]"}], "/.", 
         RowBox[{
          RowBox[{"ToExpression", "[", "Dist", "]"}], "\[Rule]", 
          "Nothing"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"IntCoefficient", "=", 
        RowBox[{"MonomialList", "[", 
         RowBox[{
          RowBox[{"ObsFunc", "[", 
           RowBox[{"ObsName", ",", "Dist"}], "]"}], ",", " ", "IntVariable"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"IntBin", "=", 
           RowBox[{"NameBin", "[", 
            RowBox[{"[", 
             RowBox[{"n", ";;", 
              RowBox[{"n", "+", "1"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Obs", "[", 
            RowBox[{"ObsName", ",", "Dist", ",", "n"}], "]"}], "=", 
           RowBox[{"Total", "[", 
            RowBox[{"ParallelMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"IntPerform", "[", 
                RowBox[{"#", ",", "IntVariable", ",", 
                 RowBox[{"ToExpression", "[", "Dist", "]"}], ",", "IntBin"}], 
                "]"}], "&"}], ",", "IntCoefficient"}], "]"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{
            RowBox[{"Length", "[", "NameBin", "]"}], "-", "1"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
