           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\<Expanding \>\"", "<>", "order", "<>", "\"\< term\>\""}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"OrderObsFunc", "[", 
