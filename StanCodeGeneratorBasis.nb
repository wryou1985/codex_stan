        "\"\<\n}\nmodel {\n\>\"", "<>", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"NPmodel", ",", "\"\<SM\>\""}], "]"}], ",", 
