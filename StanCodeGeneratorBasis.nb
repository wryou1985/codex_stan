BelleFITcent_D ~ multi_normal(BelleD_func, BelleFITcov_D);\nBelleFITcent_w ~ \
multi_normal(BelleDst_w_func, BelleFITcov_w);\nBelleFITcent_cosL ~ \
multi_normal(BelleDst_cosL_func, BelleFITcov_cosL);\nBelleFITcent_cosV ~ \
multi_normal(BelleDst_cosV_func, BelleFITcov_cosV);\nBelleFITcent_chi ~ \
multi_normal(BelleDst_chi_func, BelleFITcov_chi);\n}\ngenerated quantities{\n\
vector[2] RD_func;\nvector[2] rawBrRatio_func;\nvector[2] BrRatio_func;\n\
vector[2] BrRatio_data;\nvector[2] Vcb_Br;\nvector[10] rawBelleD_func;\n\
vector[10] rawBelleDst_w_func;\nvector[10] rawBelleDst_cosL_func;\nvector[10] \
rawBelleDst_cosV_func;\nvector[10] rawBelleDst_chi_func;\nvector[14] chi_sq;\n\
real chi_sq_total;\nreal Vcb_mean;\n\>\"", "<>", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<RD_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]= (\>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<BrTau\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<) / (\>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<Br\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<);\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "<>", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<rawBrRatio_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]=\>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<Br\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2"}], "}"}]}], "]"}], "<>", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<rawBelleD_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]= \>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<D\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "10"}], "}"}]}], "]"}], "<>", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<rawBelleDst_w_func[\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<]= \>\"", "<>", 
           RowBox[{
            RowBox[{"BelleFITfunclist", "[", "\"\<w\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<;\\n\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "10"}], "}"}]}], "]"}], "<>", 
