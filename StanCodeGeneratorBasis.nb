 RowBox[{
  RowBox[{"time", ":=", 
   RowBox[{"SessionTime", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PreIntPerformHQET", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "OrderDecayRateFunc", ",", "IntVariable", ",", "IntCoefficient"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Clear", "[", 
            RowBox[{"IntVariable", ",", "IntCoefficient", ",", "TimeStart"}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"TimeStart", "=", "time"}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"OrderDecayRateFunc", "[", 
               RowBox[{"\"\<Dst\>\"", ",", 
                RowBox[{"\"\<w_\>\"", "<>", "dist"}], ",", "order"}], "]"}], 
              "=", 
              RowBox[{
               RowBox[{"Normal", "[", 
                RowBox[{"Series", "[", 
                 RowBox[{
                  RowBox[{"ExpandObs", "[", 
                   RowBox[{
                    RowBox[{"DecayRate", "[", 
                    RowBox[{"\"\<Dst\>\"", ",", 
                    RowBox[{"\"\<w_\>\"", "<>", "dist"}]}], "]"}], ",", 
                    "order"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"z", ",", "0", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"FFnf", "-", "Nepc", "-", "Nepb"}], ")"}], "/.", 
                    RowBox[{"OrderReplace", "[", "order", "]"}]}]}], "}"}]}], 
                 "]"}], "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{"z", "->", 
                 RowBox[{"zHQET", "[", "w", "]"}]}], "}"}]}]}], ";"}], " ", 
            "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Expanding (w_\>\"", "<>", "dist", "<>", "\"\<,\>\"", "<>", 
             "order", "<>", "\"\<) term\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"OrderDecayRateFunc", "[", 
             RowBox[{"\"\<Dst\>\"", ",", 
              RowBox[{"\"\<w_\>\"", "<>", "dist"}], ",", "order"}], "]"}], 
            "=", 
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Coefficient", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"ExpandObs", "[", 
                    RowBox[{
                    RowBox[{"ExpandDecayRate", "[", 
                    RowBox[{"\"\<Dst\>\"", ",", 
                    RowBox[{"\"\<w_\>\"", "<>", "dist"}]}], "]"}], ",", 
                    "order"}], "]"}], "/.", 
                    RowBox[{"HQETreplace", "[", "\"\<als/mc_app\>\"", "]"}]}],
                    "/.", 
                   RowBox[{"HQETreplace", "[", "\"\<IW_basis\>\"", "]"}]}], 
                  ",", "z", ",", "i"}], "]"}], 
                SuperscriptBox["z", "i"]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "0", ",", 
                 RowBox[{"NzOrder", "[", "order", "]"}]}], "}"}]}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{"z", "->", 
               RowBox[{"zHQET", "[", "w", "]"}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"IntVariable", "=", 
            RowBox[{
             RowBox[{"Variables", "[", 
              RowBox[{"OrderDecayRateFunc", "[", 
               RowBox[{"\"\<Dst\>\"", ",", 
                RowBox[{"\"\<w_\>\"", "<>", "dist"}], ",", "order"}], "]"}], 
              "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{"2", "\[Chi]"}], "]"}], "->", "Cos2Chi"}], ",", 
               RowBox[{
                RowBox[{"Cos", "[", "\[Chi]", "]"}], "->", "CosChi"}], ",", 
               RowBox[{"w", "->", "Nothing"}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"IntCoefficient", "=", 
            RowBox[{"MonomialList", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"OrderDecayRateFunc", "[", 
                RowBox[{"\"\<Dst\>\"", ",", 
                 RowBox[{"\"\<w_\>\"", "<>", "dist"}], ",", "order"}], "]"}], 
               "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Cos", "[", 
                   RowBox[{"2", "\[Chi]"}], "]"}], "->", "Cos2Chi"}], ",", 
                 RowBox[{
                  RowBox[{"Cos", "[", "\[Chi]", "]"}], "->", "CosChi"}]}], 
                "}"}]}], ",", " ", "IntVariable"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Integrating (w_\>\"", "<>", "dist", "<>", "\"\<,\>\"", "<>", 
             "order", "<>", "\"\<) term\>\""}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"OrderDecayRate", "[", 
             RowBox[{"\"\<Dst\>\"", ",", "dist", ",", "order"}], "]"}], "=", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"ParallelMap", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"IntPerform", "[", 
                  RowBox[{"#", ",", "IntVariable", ",", "w", ",", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"wDstMax", "-", "0.001"}]}], "}"}]}], "]"}], 
                 "&"}], ",", "IntCoefficient"}], "]"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos2Chi", "->", 
                RowBox[{"Cos", "[", 
                 RowBox[{"2", "\[Chi]"}], "]"}]}], ",", 
               RowBox[{"CosChi", "->", 
                RowBox[{"Cos", "[", "\[Chi]", "]"}]}]}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Calculation time: \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"time", "-", "TimeStart"}], "]"}], "<>", 
             "\"\<sec.\>\""}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"order", ",", "OrderListAll"}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"DecayRate", "[", 
          RowBox[{"\"\<Dst\>\"", ",", "dist"}], "]"}], "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"OrderDecayRate", "[", 
            RowBox[{"\"\<Dst\>\"", ",", "dist", ",", "OrderName"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"OrderName", ",", "OrderListAll"}], "}"}]}], "]"}]}], 
        ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"dist", ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<cosL\>\"", ",", "\"\<cosV\>\"", ",", "\"\<\[Chi]\>\""}], 
          "}"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ObsIntPerformHQET", "[", 
    RowBox[{"ObsName_", ",", "Dist_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "OrderObsFunc", ",", "NameBin", ",", "IntVariable", ",", "IntBin", ",", 
       "IntCoefficient"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<[Integration for \>\"", "<>", "ObsName", "<>", "\"\<]\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"TimeStart", "=", "time"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Dist", "==", "\"\<cosL\>\""}], "||", 
         RowBox[{"Dist", "==", "\"\<cosV\>\""}], "||", 
         RowBox[{"Dist", "==", "\"\<\[Chi]\>\""}]}], "\[IndentingNewLine]", 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Please use 'ObsIntPerform' for (cosL, cosV, \[Chi]). Use \
'ObsIntPerformHQET' for w\>\"", "]"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"ObsName", ",", "\"\<BrRatio\>\""}], "]"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"OrderObsFunc", "[", 
                RowBox[{"ObsName", ",", "Dist", ",", "order"}], "]"}], "=", 
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Coefficient", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"ExpandObs", "[", 
                    RowBox[{
                    RowBox[{"ExpandObsFunc", "[", 
                    RowBox[{"ObsName", ",", "Dist"}], "]"}], ",", "order"}], 
                    "]"}], "/.", 
                    RowBox[{"HQETreplace", "[", "\"\<als/mc_app\>\"", "]"}]}],
                     "/.", 
                    RowBox[{"HQETreplace", "[", "\"\<IW_basis\>\"", "]"}]}], 
                    ",", "z", ",", "i"}], "]"}], 
                   SuperscriptBox["z", "i"]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "0", ",", 
                    RowBox[{"NzOrder", "[", "order", "]"}]}], "}"}]}], "]"}], 
                "/.", 
                RowBox[{"{", 
                 RowBox[{"z", "->", 
                  RowBox[{"zHQET", "[", "w", "]"}]}], "}"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"IntVariable", "=", 
               RowBox[{
                RowBox[{"Variables", "[", 
                 RowBox[{"OrderObsFunc", "[", 
                  RowBox[{"ObsName", ",", "Dist", ",", "order"}], "]"}], 
                 "]"}], "/.", 
                RowBox[{"w", "\[Rule]", "Nothing"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"IntCoefficient", "=", 
               RowBox[{"MonomialList", "[", 
                RowBox[{
                 RowBox[{"OrderObsFunc", "[", 
                  RowBox[{"ObsName", ",", "Dist", ",", "order"}], "]"}], ",", 
