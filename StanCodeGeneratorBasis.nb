Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"StanCodeGenerate", "[", "\"\<CasePDG-noUB\>\"", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "WhichFF", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"ValueQ", "[", "FFmodel", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"ValueQ", "[", "NPmodel", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"ValueQ", "[", "FFnf", "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<Speficy models. Stan code is not generated.\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "]"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Stan code for '\>\"", "<>", "AnalysisName", "<>", 
           "\"\<' is generating...\>\""}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"standata", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
        "MILC15data", ",", "bglMILC21data", ",", "bglJLQCD23data", ",", 
         "bglHPQCD23data", ",", "bszLCSR18data", ",", "bszLCSR23data", ",", 
         "BrRatio2025data", ",", "BellFITdata"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{
        "\"\<Stan_data/standata_\>\"", "<>", "AnalysisName", "<>", 
         "\"\<.json\>\""}], ",", "standata", ",", "\"\<JSON\>\""}], "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FFmodel", "==", "\"\<HQET\>\""}], "\[IndentingNewLine]", ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HQETset", "[", "HQETmodel", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SpecifyModel", "[", 
          RowBox[{"FFmodel", ",", "HQETmodel"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SpecifyKinetic", "[", "\"\<On\>\"", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Get", "[", 
          RowBox[{
          "\"\<Stan_intfunctions/IntFunctions_\>\"", "<>", "FFmodel", "<>", 
           "\"\<.ma\>\""}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"SpecifyModel", "[", 
          RowBox[{"FFmodel", ",", "FFnf"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"SpecifyKinetic", "[", "\"\<On\>\"", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Get", "[", 
          RowBox[{
          "\"\<Stan_intfunctions/IntFunctions_\>\"", "<>", "FFmodel", "<>", 
           "\"\<.ma\>\""}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"FFsetup", "[", 
       RowBox[{"FFmodel", ",", "NPmodel"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ParamList", "=", 
       RowBox[{
        RowBox[{"FFlist", "~", "Join", "~", 
         RowBox[{"NPpara", "[", "NPmodel", "]"}]}], "//", 
        "DeleteDuplicates"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"StanForm", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"ParamList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "<>", "\"\<**2\>\""}], 
          "\[Rule]", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"ParamList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "<>", "\"\<*\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"ParamList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "ParamList", "]"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MathToStan", "[", "func_", "]"}], ":=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToString", "[", 
          RowBox[{"DecimalForm", "[", 
           RowBox[{"FortranForm", "[", "func", "]"}], "]"}], "]"}], ",", 
         "StanForm"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"WhichFF", "=", 
       RowBox[{"Switch", "[", 
        RowBox[{
        "FFmodel", ",", "\"\<BSZ\>\"", ",", "BSZff", ",", "\"\<BGL\>\"", ",", 
         "BGLff", ",", "\"\<HQET\>\"", ",", "HQETff"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"MILC15funclist", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"MathToStan", "[", 
           RowBox[{"ChopSmallTerm", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"WhichFF", "[", 
                 RowBox[{
                  RowBox[{"FFmodel", "<>", "\"\<_\>\"", "<>", "ff"}], ",", 
                  "FFnf", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"FFmodel", "==", "\"\<HQET\>\""}], ",", "w", ",", 
                    RowBox[{"qSQfuncD", "[", "w", "]"}]}], "]"}]}], "]"}], "/.",
                 "NLOcut"}], "//.", "KineticReplace"}], "]"}], ",", 
             "CutControl"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"ff", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<fp\>\"", ",", "\"\<f0\>\""}], "}"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"w", ",", 
            RowBox[{"Bin", "[", 
             RowBox[{"\"\<MILC15\>\"", ",", "\"\<w\>\""}], "]"}]}], "}"}]}], 
         "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"MILC21funclist", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"MathToStan", "[", 
           RowBox[{"ChopSmallTerm", "[", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{
