  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SpecifyKinetic", "[", "choice_", "]"}], ":=", 
   RowBox[{"Switch", "[", "\[IndentingNewLine]", 
    RowBox[{
    "choice", ",", "\[IndentingNewLine]", "\"\<On\>\"", ",", 
     "\[IndentingNewLine]", 
