                   RowBox[{"ObsName", "==", "\"\<BrRatio2025\>\""}], ",", 
                   RowBox[{
                    RowBox[{"wMax", "[", "Dist", "]"}], "-", "0.001"}], ",", 
                   RowBox[{
                    RowBox[{"wMaxTau", "[", "Dist", "]"}], "-", "0.001"}]}], 
                  "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"OrderObs", "[", 
                RowBox[{"ObsName", ",", "Dist", ",", "order"}], "]"}], "=", 
