                RowBox[{"ParallelMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"IntPerform", "[", 
                    RowBox[{
                    "#", ",", "IntVariable", ",", "w", ",", "IntBin"}], "]"}],
                    "&"}], ",", "IntCoefficient"}], "]"}], "]"}]}], ";"}], 
             "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
