        RowBox[{"LCSR18funclist", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", "i", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "TensorList"}], "}"}]}], "]"}]}], "]"}]}], ";", 
