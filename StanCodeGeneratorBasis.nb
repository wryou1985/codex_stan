Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ChopSmallTerm", "[", 
    RowBox[{"func_", ",", "cut_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "terms", ",", "vars", ",", "coeff", ",", "coeffs", ",", " ", "maxcoeff",
        ",", "threshold"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"terms", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "func", "]"}], "===", "Plus"}], ",", 
         RowBox[{"List", "@@", "func"}], ",", 
         RowBox[{"{", "func", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"vars", "=", 
       RowBox[{"Variables", "[", "func", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"coeff", "[", "t_", "]"}], ":=", 
       RowBox[{"t", "/", 
        RowBox[{"(", 
         RowBox[{"Times", "@@", 
          RowBox[{"(", 
           RowBox[{"vars", "^", 
            RowBox[{"Exponent", "[", 
             RowBox[{"t", ",", "vars"}], "]"}]}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coeffs", "=", 
       RowBox[{"coeff", "/@", "terms"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"maxcoeff", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", "coeffs", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", 
       RowBox[{"maxcoeff", "  ", "cut"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Total", "@", 
       RowBox[{"Select", "[", 
        RowBox[{"terms", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", 
             RowBox[{"coeff", "[", "#", "]"}], "]"}], "]"}], ">=", 
           "threshold"}], "&"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NLOpara", "=", 
   RowBox[{"{", 
    RowBox[{
    "cet1", ",", "cet2", ",", "cci20", ",", "cci21", ",", "cci22", ",", 
     "cci31", ",", "cci32"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NLOsq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Times", "@@", 
      RowBox[{"(", 
       RowBox[{"NLOpara", "^", "#"}], ")"}]}], "&"}], "/@", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Tuples", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "2"}], "]"}], ",", 
        RowBox[{"Length", "[", "NLOpara", "]"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", "#", "]"}], "==", "2"}], "&"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NLOcut", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", "->", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "NLOsq"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988365625135025*^9, 3.9883656254344883`*^9}, {
  3.9883656649618835`*^9, 3.9883656652330976`*^9}, {3.9883667011903486`*^9, 
  3.9883667136368876`*^9}, {3.9883679099803925`*^9, 3.988367910283516*^9}, {
  3.988953787552196*^9, 3.98895378792087*^9}},
 CellLabel->
  "In[1887]:=",ExpressionUUID->"b0cc2f78-7bd0-41db-bf6f-22ff1c4f2ad8"],

Cell[TextData[{
 StyleBox["Definition:  ",
  FontColor->RGBColor[0, 0, 1]],
 "\n  Func =  sum_i coefficient_i parameter_i\n  Terms with coefficient_i / \
coefficient_max < ",
 StyleBox["CutControl",
  FontColor->RGBColor[1, 0, 0]],
 " are removed. \n  Ex) Func = 20 c1 + 4 c2 + 0.6 c1*c2 + 0.05 c1^2 + 0.003 \
c2^2 \[LongRightArrow] coefficient_max = 20, ",
 StyleBox["CutControl",
  FontColor->RGBColor[1, 0, 0]],
 " = 10^-3 means \[OpenCurlyDoubleQuote]0.003 c2^2\[CloseCurlyDoubleQuote] \
term is removed.\n",
 StyleBox["Note:\n  ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["CutControl",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[" ",
  FontColor->RGBColor[0, 0, 1]],
 StyleBox["= 10^-4 is sufficient for all the FF model.",
  FontColor->GrayLevel[0]],
 "\n  HQET3/2/1 stan code becomes too long for ",
 StyleBox["CutControl",
  FontColor->RGBColor[1, 0, 0]],
 " = 10^-4 so that fit analysis cannot run. (c++ compile failed due to large \
fit functions.)\n  10^-3 cut could affect numerical result at a few % level, \
but 10^-4 does not work at least for HQET3/2/1"
}], "Text",
 CellChangeTimes->{{3.98836706731547*^9, 3.988367404473461*^9}, {
  3.988368251913726*^9, 3.988368328108368*^9}, {3.9883704356594763`*^9, 
  3.9883705698563156`*^9}, {3.9883706036257544`*^9, 3.988370614554533*^9}, {
  3.988370661509723*^9, 3.9883706742791843`*^9}, {3.988370707676242*^9, 
  3.9883707298487563`*^9}, {3.9887952886996927`*^9, 3.988795366062643*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"bfceaf1e-33a4-4114-9bd5-8ada990d62ed"],

