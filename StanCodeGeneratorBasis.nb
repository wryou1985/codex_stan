                    RowBox[{
                    RowBox[{
                    RowBox[{"ExpandObs", "[", 
                    RowBox[{
                    RowBox[{"ExpandObsFunc", "[", 
                    RowBox[{"ObsName", ",", "Dist"}], "]"}], ",", "order"}], 
                    "]"}], "/.", 
